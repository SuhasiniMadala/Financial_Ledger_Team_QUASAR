            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('transferId', pm.response.json().transactionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay: same key, same body -> same 201, Idempotent-Replayed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ashaToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{transferKey}}"
