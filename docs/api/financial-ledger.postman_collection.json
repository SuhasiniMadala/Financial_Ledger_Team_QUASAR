{
  "info": {
    "name": "Financial Ledger API - Team QUASAR",
    "description": "Happy path plus negative and idempotency cases (SRS 2.6). Run in order. Amounts are integer paise. Set adminEmail/adminPassword as current values only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminEmail",
      "value": "admin@local.test"
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
